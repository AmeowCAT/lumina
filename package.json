{
  "name": "lumina",
  "private": true,
  "version": "0.9.1",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-version.mjs && npm run check:types && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:desktop": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "version": "node scripts/sync-version.mjs",
    "postversion": "git add src-tauri/tauri.conf.json src-tauri/Cargo.toml src-tauri/Cargo.lock",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "check:version": "node scripts/check-version.mjs",
    "check:release": "node scripts/check-version.mjs --release",
    "check:upstream": "node scripts/upstream-diff.mjs",
    "check:upstream:coverage": "node scripts/upstream-diff.mjs --coverage"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-notification": "2.3.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "motion": "^12.42.2",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.11.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
