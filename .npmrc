# npm version 默认只改版本文件，不自动 commit / 打 tag。
git-tag-version=false
# 注意：不要用 `npm version patch --git-tag-version`。npm 的 git 集成只会
# `git add package.json` 与 lock 文件，而 version 钩子（scripts/sync-version.mjs）
# 同时改写了 tauri.conf.json / Cargo.toml / Cargo.lock。打了 tag 却漏 add，
# 从该 tag 构建出的安装包版本号会回退。
#
# 正确流程：
#   npm version patch            # 5 处版本号一起变，不提交
#   git add -A                   # postversion 已经 add 了三个 Rust 文件
#   git commit -m "chore: 版本号 x.y.z"
#   git tag -a vx.y.z -m "Lumina x.y.z"
#   npm run check:release        # 断言 5 处一致 + tag 存在
engine-strict=true
